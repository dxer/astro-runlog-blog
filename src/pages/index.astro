---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import MediaWindow from '../components/MediaWindow.astro';
import RunLog from '../components/RunLog.astro';
import {
  site,
  sections,
  hero,
  terminal,
  categories,
  framework,
  principlesSection,
  ctaSection,
  getCategoryMeta,
} from '../config';
import { t, formatDate } from '../i18n';

const allPosts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentPosts = allPosts.slice(0, 4);
---

<Base>
  <!-- [00] Hero 视窗 -->
  <Section top={false} inner="px-6 pt-16 pb-20 lg:pt-24 lg:pb-28 max-md:px-5 overflow-hidden" label="Hero">
    <div class="grid-bg" style="--gx:74%;--gy:50%" aria-hidden="true"></div>
    <div class:list={['relative items-center gap-14 lg:gap-12', sections.terminal ? 'grid grid-cols-1 lg:grid-cols-[1fr_560px]' : 'max-w-[760px]']}>
      <div>
        <p class="label"><b>[00]</b> {hero.label}</p>
        <h1 class="mt-5 text-[clamp(40px,5.4vw,66px)] leading-[1.05] font-bold tracking-[-0.045em] whitespace-pre-line">{hero.title}</h1>
        <p class="mt-6 max-w-[48ch] text-[16px] leading-[1.65] text-steel max-md:text-[15px] whitespace-pre-line">{hero.lede}</p>
        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href={hero.primaryButton.href} class="btn btn-primary max-md:w-full">{hero.primaryButton.label}</a>
          {hero.secondaryButton && <a href={hero.secondaryButton.href} class="link text-[15px]">{hero.secondaryButton.label}</a>}
        </div>
        <div class="mt-7 flex items-center w-fit max-w-full border border-rule bg-canvas text-[13px]">
          <code class="px-4 py-2.5 text-ink truncate"><span class="text-smoke select-none">$ </span>{hero.code.replace(/^\$\s*/, '')}</code>
          <span class="px-3.5 py-2.5 border-l border-rule text-smoke text-[12px]">{t.archiveCount(allPosts.length)}</span>
        </div>
      </div>
      {sections.terminal && (
        <MediaWindow title={terminal.filename} shadow>
          <RunLog />
        </MediaWindow>
      )}
    </div>
  </Section>

  <!-- [01] 核心思考领域 (完全由 config.yaml 的 categories 驱动) -->
  {sections.pillars && categories.length > 0 && (
    <Section id="pillars" inner="pt-6" label="Pillars">
      <p class="label px-6 max-md:px-5"><b>[01]</b> 核心领域 · topics</p>
      <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-t border-rule">
        {categories.map((item, i) => (
          <li class="flex flex-col justify-between p-6 border-b border-r border-rule last:border-r-0">
            <div>
              <div class="flex items-center justify-between text-smoke text-[12px] font-mono mb-2">
                <span>[0{i + 1}]</span>
                <span class="text-[11px] uppercase">{item.en}</span>
              </div>
              <h3 class="text-[18px] font-bold text-ink tracking-tight mb-2">{item.label}</h3>
              <p class="text-[13px] text-steel leading-relaxed">{item.description}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-rule/50">
              <a href={`/posts`} class="text-[12px] text-link hover:underline">{t.exploreCategory}</a>
            </div>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <!-- [02] 决策与认知闭环框架 (模块开关控制) -->
  {sections.framework && framework.loop.length > 0 && (
    <Section id="framework" label="Framework">
      <SectionHead idx="02" label={framework.label} title={framework.title} lede={framework.lede} />
      <ol class="mt-14 grid md:grid-cols-3 max-md:gap-0">
        {framework.loop.map((s, i) => (
          <li class="relative max-md:pl-14 max-md:pb-8 max-md:before:absolute max-md:before:left-[22px] max-md:before:top-11 max-md:before:bottom-0 max-md:before:border-l max-md:before:border-dashed max-md:before:border-ink">
            <div class="flex items-center max-md:absolute max-md:left-0 max-md:top-0">
              <span class:list={['flex items-center gap-2.5 border border-ink px-4 py-3 text-[14px] font-bold tracking-[0.06em] max-md:size-11 max-md:justify-center max-md:p-0', i === 1 ? 'bg-ink text-canvas' : 'text-ink']}>
                <span class:list={['font-medium', i === 1 ? 'text-canvas' : 'text-smoke']}>{s.idx}</span>
                <span class="max-md:hidden">{s.name}</span>
              </span>
              <span class="flex-1 border-t border-dashed border-ink max-md:hidden" aria-hidden="true"></span>
              <span class="text-ink font-bold max-md:hidden" aria-hidden="true">&gt;</span>
              {i === framework.loop.length - 1 ? (
                <span class="ml-4 flex items-center gap-2 border border-ink bg-cta text-cta-ink px-4 py-3 text-[14px] font-bold tracking-[0.06em] max-md:hidden">VERIFIED ✓</span>
              ) : <span class="w-4 max-md:hidden"></span>}
            </div>
            <div class="md:mt-5 md:pr-8">
              <p class="text-[12px] text-smoke tracking-[0.08em] md:hidden">{s.name}</p>
              <h3 class="mt-1 text-[18px] font-bold tracking-[-0.02em]">{s.title}</h3>
              <p class="mt-2 text-[14px] leading-[1.6] text-steel">{s.body}</p>
              <p class="mt-3 inline-block bg-tint px-3 py-1.5 text-[11px] font-mono text-ink">{s.out}</p>
            </div>
          </li>
        ))}
        <li class="md:hidden"><span class="inline-flex items-center gap-2 border border-ink bg-cta text-cta-ink px-4 py-3 text-[13px] font-bold tracking-[0.06em]">VERIFIED ✓</span></li>
      </ol>
    </Section>
  )}

  <!-- [03] 最新文章精选 (模块开关控制) -->
  {sections.recentPosts && allPosts.length > 0 && (
    <Section label="Articles" inner="px-6 py-20 max-md:px-5 max-md:py-12">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <div>
          <p class="label"><b>[03]</b> recent entries · 最新记录</p>
          <h2 class="mt-3 text-[32px] max-md:text-[24px] font-bold tracking-tight">{t.recentArticles}</h2>
        </div>
        <a href="/posts" class="link text-[14px]">{t.allArchive(allPosts.length)}</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {recentPosts.map((post) => (
          <a href={`/posts/${post.id}`} class="group border border-rule p-6 bg-canvas hover:border-ink transition-colors flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-[12px] text-smoke mb-3">
                <span class="pill bg-ink text-canvas tracking-[0.06em] !text-[10px]">{getCategoryMeta(post.data.category).label}</span>
                <span>{formatDate(post.data.date)} · {post.data.readingTime} {t.minShort}</span>
              </div>
              <h3 class="text-[20px] max-md:text-[17px] font-bold text-ink group-hover:underline underline-offset-4 decoration-2 leading-snug mb-3">
                {post.data.title}
              </h3>
              <p class="text-[14px] text-steel leading-[1.6] line-clamp-2">
                {post.data.excerpt}
              </p>
            </div>
            <div class="mt-6 pt-3 border-t border-rule/50 flex items-center justify-between text-[12px] text-smoke">
              <span>{t.byAuthor(post.data.author || site.author)}</span>
              <span class="text-ink font-semibold group-hover:translate-x-1 transition-transform inline-block">{t.readFull}</span>
            </div>
          </a>
        ))}
      </div>
    </Section>
  )}

  <!-- [04] 底层心智模型与准则 (模块开关控制) -->
  {sections.principles && principlesSection.items.length > 0 && (
    <Section id="principles" label="Principles" mode="invert" inner="px-6 py-24 max-md:px-5 max-md:py-14">
      <SectionHead idx="04" label={principlesSection.label} title={principlesSection.title} lede={principlesSection.lede} />
      <ul class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 border-t border-l border-rule">
        {principlesSection.items.map((item) => (
          <li class="flex flex-col p-6 border-r border-b border-rule">
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-mono text-smoke">[{item.id}]</span>
              <span class="text-[11px] font-mono text-smoke">{item.rule}</span>
            </div>
            <h3 class="text-[17px] font-bold text-ink mb-2">{item.name}</h3>
            <p class="text-[13px] text-steel leading-relaxed">{item.note}</p>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <!-- [05] 底部简约行动条 (模块开关控制) -->
  {sections.cta && (
    <Section inner="px-6 py-20 max-md:px-5 max-md:py-12 text-center" label="Footer CTA">
      <p class="label"><b>[05]</b> {ctaSection.label}</p>
      <h2 class="mt-4 text-[clamp(28px,3.8vw,44px)] font-bold tracking-tight">{ctaSection.title}</h2>
      <p class="mt-3 text-[15px] text-steel max-w-[48ch] mx-auto">{ctaSection.lede}</p>
      <div class="mt-8 flex justify-center gap-4 flex-wrap">
        <a href={ctaSection.primaryButton.href} class="btn btn-primary">{ctaSection.primaryButton.label}</a>
        {ctaSection.secondaryButton && <a href={ctaSection.secondaryButton.href} class="border border-rule px-4 py-2.5 text-[13px] text-steel hover:text-ink">{ctaSection.secondaryButton.label}</a>}
      </div>
    </Section>
  )}
</Base>
