{
  "name": "astro-runlog-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "cp dist/sitemap-index.xml dist/sitemap.xml || true",
    "deploy": "astro build && cp dist/sitemap-index.xml dist/sitemap.xml && rm -rf /var/www/blog/* && cp -r dist/* /var/www/blog/ && chown -R caddy:caddy /var/www/blog && systemctl reload caddy",
    "preset": "node scripts/use-preset.mjs",
    "new": "node scripts/new-post.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "js-yaml": "^5.5.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  }
}
